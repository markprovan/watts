---
import { Image } from 'astro:assets';
import '../styles/global.css';
import phoneLight from '../assets/shots/phone-light.png';
import phoneDark from '../assets/shots/phone-dark.png';
import power from '../assets/shots/power.png';
import forecast from '../assets/shots/forecast.png';
import temperature from '../assets/shots/temperature.png';
import timeLeft from '../assets/shots/time-left.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/markprovan/watts';
const download = `${repo}/releases/latest`;
const title = 'Watts: see how fast your phone is charging';
const description =
  'See how fast your phone is charging: power in watts, time to 80% and 100%, and battery temperature. Free, no ads, no account, no permissions.';
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
const pageUrl = new URL(`${base}/`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff9ec" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="wrap">
      <header class="top">
        <div class="brand">
          <img src={`${base}/icon.png`} alt="" width="44" height="44" />
          <span>Watts</span>
        </div>
        <a class="top-link" href={repo}>View on GitHub</a>
      </header>
    </div>

    <main id="main">
      <div class="wrap hero">
        <div class="hero-text">
          <h1>See <span class="marker">how fast</span> your phone is charging.</h1>
          <p class="lede">
            Charging power, time to 80% and 100%, and battery temperature, on one screen.
          </p>
          <div class="cta">
            <a class="btn" href={download}>Download for Android</a>
            <span class="small">Android 7.0 or later</span>
          </div>
          <ul class="checks">
            {
              ['Free and open source', 'No ads', 'No account', 'No permissions'].map((item) => (
                <li>
                  <svg aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="phones">
          <div class="phones-inner">
            <div class="phone phone-a">
              <Image
                src={phoneLight}
                width={500}
                alt="Watts while charging in light mode: 15.8 watts, 42 percent"
                loading="eager"
              />
            </div>
            <div class="phone phone-b">
              <Image src={phoneDark} width={500} alt="Watts while charging in dark mode" loading="eager" />
            </div>
          </div>
        </div>
      </div>

      <section class="band band-white" aria-labelledby="four">
        <div class="wrap">
          <h2 class="h2" id="four">What it shows</h2>
          <div class="rows">
            <div class="row">
              <div class="row-text">
                <div class="badge" aria-hidden="true">1</div>
                <h3>How many watts?</h3>
                <p>The power going into your battery, live.</p>
              </div>
              <div class="panel mint">
                <div class="shot">
                  <Image
                    src={power}
                    width={600}
                    alt="Watts showing 15.8 watts and a battery bar with an 80 percent marker"
                  />
                </div>
              </div>
            </div>

            <div class="row">
              <div class="row-text">
                <div class="badge" aria-hidden="true">2</div>
                <h3>When will it be ready?</h3>
                <p>Time to 80% and 100%, plus a forecast for every 10% in between.</p>
              </div>
              <div class="panel butter">
                <div class="shot">
                  <Image
                    src={forecast}
                    width={600}
                    alt="Charge forecast from 50 to 100 percent with clock times, and the time to 80 and 100 percent"
                  />
                </div>
              </div>
            </div>

            <div class="row">
              <div class="row-text">
                <div class="badge" aria-hidden="true">3</div>
                <h3>Is it getting hot?</h3>
                <p>Battery temperature, marked Normal, Warm or Hot.</p>
              </div>
              <div class="panel blush">
                <div class="shot">
                  <Image
                    src={temperature}
                    width={600}
                    alt="Battery temperature of 33.4 degrees marked Normal, with current and voltage"
                  />
                </div>
              </div>
            </div>

            <div class="row">
              <div class="row-text">
                <div class="badge" aria-hidden="true">4</div>
                <h3>How long will it last?</h3>
                <p>Unplugged, how long you have left at your current use.</p>
              </div>
              <div class="panel sky">
                <div class="shot">
                  <Image
                    src={timeLeft}
                    width={600}
                    alt="Watts on battery showing about 11 hours 20 minutes left and a drain of 240 milliamps"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="band band-dark band-slim on-dark" aria-label="Good to know">
        <div class="wrap">
          <p class="note">Times are estimates. Phones slow down after 80%, so 90% and 100% take longer than shown.</p>
        </div>
      </section>

      <section class="band" aria-labelledby="install">
        <div class="wrap">
          <h2 class="h2" id="install">Install</h2>
          <ol class="steps">
            <li class="step">
              <div class="num" aria-hidden="true">1</div>
              <h3>Download the APK</h3>
              <p>From the latest release, on your phone.</p>
            </li>
            <li class="step">
              <div class="num" aria-hidden="true">2</div>
              <h3>Open it</h3>
              <p>Allow installs if Android asks.</p>
            </li>
            <li class="step">
              <div class="num" aria-hidden="true">3</div>
              <h3>Plug in</h3>
              <p>Open Watts and connect a charger.</p>
            </li>
          </ol>
        </div>
      </section>

      <section class="band band-green on-dark" aria-labelledby="closing">
        <div class="wrap closing">
          <h2 id="closing">Plug in and see.</h2>
          <a class="btn btn-yellow" href={download}>Download for Android</a>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <span>Watts is made by Mark Provan. MIT licence.</span>
      <nav aria-label="Links">
        <a href={repo}>Source on GitHub</a>
        <a href={`${repo}/releases`}>All releases</a>
        <a href={`${repo}/tree/main/site/src/assets/fonts`}>Font licences</a>
      </nav>
    </footer>
  </body>
</html>
